# Google Analytics 4 — identifiant de mesure (production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PR8420NGC1

# Meta Pixel (marketing — uniquement si consentement marketing)
NEXT_PUBLIC_META_PIXEL_ID=

# Lodgify API (serveur uniquement)
LODGIFY_API_KEY=

# Brevo newsletter (serveur uniquement)
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Bons cadeaux (serveur uniquement, jamais NEXT_PUBLIC_*) ---

# Supabase PostgreSQL — pooler transactionnel pour l’app (Vercel) : prepare désactivé côté code
DATABASE_URL=

# Migrations Drizzle / scripts — connexion directe ou Session pooler Supabase (port 5432)
DATABASE_MIGRATION_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# test | live — validation réelle : live + sk_live + webhook prod
STRIPE_EXPECTED_LIVEMODE=live

# Identifiants Stripe par offre (Dashboard → Payment Links → prix associé)
GIFT_CARD_STRIPE_PRICE_ID_50=
GIFT_CARD_STRIPE_PRICE_ID_100=
GIFT_CARD_STRIPE_PRICE_ID_265=
GIFT_CARD_STRIPE_PRICE_ID_315=
GIFT_CARD_STRIPE_PAYMENT_LINK_ID_50=
GIFT_CARD_STRIPE_PAYMENT_LINK_ID_100=
GIFT_CARD_STRIPE_PAYMENT_LINK_ID_265=
GIFT_CARD_STRIPE_PAYMENT_LINK_ID_315=

# E-mail transactionnel Resend
RESEND_API_KEY=
GIFT_CARD_FROM_EMAIL=IBU Experience <no-reply@ibu-experience.be>
GIFT_CARD_REPLY_TO_EMAIL=info@ibu-experience.be
# mock | resend | resend_allowlisted
GIFT_CARD_EMAIL_MODE=mock
# Liste d’adresses autorisées en mode resend_allowlisted (séparées par des virgules)
GIFT_CARD_TEST_RECIPIENT_ALLOWLIST=

# Développement/tests uniquement
# GIFT_CARD_USE_FIXTURE_ALLOWLIST=true
# GIFT_CARD_ALLOW_PENDING_COMMERCIAL=true  # développement uniquement, jamais en production

# Audit Stripe en sk_test (lecture prices) sans toucher aux clés live
# GIFT_CARD_STRIPE_AUDIT_SECRET_KEY=
# Autoriser tests d’intégration DB quand STRIPE_EXPECTED_LIVEMODE=live (déconseillé)
# GIFT_CARD_INTEGRATION_ALLOW_LIVE_DB=
